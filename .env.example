# Copy to `.env` and fill in real values. `.env` is gitignored — do NOT commit secrets.
#
# agents.yaml lists which agents exist; this file supplies hosts / ids / secrets.

# -- Knowledge Agent (ADK) --
# Local ADK is plain HTTP (not https). Wrong scheme → SSL:WRONG_VERSION_NUMBER
# and ADK logs "Invalid HTTP request received."
KNOWLEDGE_ADK_BASE_URL=http://localhost:8080
KNOWLEDGE_ADK_BASE_PATH=
KNOWLEDGE_ADK_APP_NAME=knowledge_agent
KNOWLEDGE_ADK_USER_ID=eval_user

# -- Fact Find Workflow (ADK) --
# Full URL including /cct1/hive1/hive-complaints-agent (not host-only).
# Alias: ADK_BASE_HOST / ADK_APP_NAME / ADK_USER_ID (working factfind repo names).
FACTFIND_ADK_BASE_URL=https://web203-int-ew2.c2.test.lbgcp.cloud/cct1/hive1/hive-complaints-agent
FACTFIND_ADK_BASE_PATH=
FACTFIND_ADK_APP_NAME=fact_find_workflow
FACTFIND_ADK_USER_ID=bdduser

# -- CORTEX LLM gateway (DeepEval judges — Apigee / control-plane) --
# Copy EXACTLY from working factfind env/.env.factfind.api:
#   CORTEX_HOST, CORTEX_CLIENT_ID, (optional secret)
CORTEX_HOST=https://web201-int-ew2.c2.test.lbgcp.cloud/int/control-plane-api/v1/
CORTEX_MODEL=vertex_ai/gemini-2.5-pro
CORTEX_CLIENT_ID=
CORTEX_CLIENT_SECRET=

# -- Pegasus / CorteX 2.0 developer route (OpenAI-compatible) --
# Used by sanity_pegasus judges (src/runners/pegasus_judge.py)
# From CorteX Console: API key as Bearer token; no client certs required.
CORTEX_BASE_URL=https://cortex.lloydsbanking.cloud/api/v1
CORTEX_API_KEY=your_api_key_here
PEGASUS_CORTEX_MODEL=gemini-3.1-lite
# PEGASUS_CERT_PATH=/etc/ssl/certs/lbg-root-ca
