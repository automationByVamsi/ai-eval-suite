# Copy to .env (make setup does this) and fill in. .env is never committed.

# --- Agents (used in agents/<name>/agent.yaml) ---
KNOWLEDGE_ADK_BASE_URL=http://localhost:8080
KNOWLEDGE_ADK_APP_NAME=knowledge_agent
FACTFIND_ADK_BASE_URL=
FACTFIND_ADK_APP_NAME=fact_find_workflow

# --- Judge model via CORTEX (DeepEval) ---
CORTEX_HOST=https://<cortex-host>/.../v1        # the client appends /chat/completions
CORTEX_MODEL=vertex_ai/gemini-2.5-pro
CORTEX_CLIENT_ID=
CORTEX_VERIFY_TLS=true                          # false only for local sandboxes
# CORTEX_CA_BUNDLE=/path/to/corporate-ca.pem    # preferred over turning TLS checks off

# --- Pegasus (only if the Pegasus package is installed) ---
# CorteX 2.0: base url + api key.  Or: CORTEX_CLIENT_ID + CORTEX_CLIENT_SECRET.
CORTEX_BASE_URL=
CORTEX_API_KEY=
CORTEX_CLIENT_SECRET=
PEGASUS_CORTEX_MODEL=gemini-2.5-flash
# PEGASUS_CERT_PATH=
