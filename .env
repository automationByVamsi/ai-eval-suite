CORTEX_MODEL=vertex_ai/gemini-2.5-pro
# IMPORTANT: paste EXACTLY from working env/.env.factfind.api (not from photos).
# A one-character difference → HTTP 401 No_matching_project_found.
CORTEX_CLIENT_ID=ZiYPYzVGdG43FByBorCyCOSMlac0tHkw6s397GVGs9f8cx7S
CORTEX_CLIENT_SECRET=XWJKGIN1ChVXKwghYKWU1G1gb62cQZLtSaSnWP5dkv4V2ltOA4zGvB7CsMyXyTWZ
ATHENA_ID=ZiYPYzVGdG43FByBorCyCOSMlac0tHkw6s397GVGs9f8cx7S

# -- Pegasus / CorteX 2.0 developer route (OpenAI-compatible) --
# Used by: make test-ka-sanity-pegasus-judges  (src/runners/pegasus_judge.py)
