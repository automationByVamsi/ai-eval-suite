__pycache__/
*.pyc
.venv/
.env.factfind.api
.pytest_cache/
uv.lock.bak
.claude/
# evaluation outputs are regenerated by running the framework - traces under
# outputs/traces/.../sanity/ are the exception, committed as fixtures
outputs/*.json
outputs/dashboard/
outputs/verdict/

# synth.py's cache of source docs materialized as .txt for DeepEval's Synthesizer
data/**/_generated_txt/
.deepeval/

# Fact Find APIC mTLS material (keep .gitkeep only)
data/fact_find_workflow/certs/*
!data/fact_find_workflow/certs/.gitkeep
