# Copy to env/.env (make setup does this) and fill in. Nothing in env/ except this file is committed.
# Put comments on their own line, above the setting — never after an empty value.
# Agent-only values can go in env/.env.<agent> instead (e.g. env/.env.knowledge_agent); they
# override env/.env for that agent. Variables already set in your shell win over both files.

# --- SAR token (read only by `make setup`: installs Pegasus and the CorteX DevKit) ---
# Your SAR token — the same values the Pegasus guide puts in pip.conf as <USER_TOKEN_NAME> / <USER_TOKEN_PASS_CODE>.
SAR_TOKEN_NAME=
SAR_TOKEN_PASS_CODE=

# --- HTTPS certificates (every call: CORTEX, Pegasus, DeepEval, Athena, agents) ---
# The office proxy re-signs HTTPS traffic, so Python's own certificate checks fail
# ("SSL: CERTIFICATE_VERIFY_FAILED"). Either skip the checks (what main did) or trust the corporate CA.
VERIFY_TLS=false
# Better, if you have the corporate CA file — checks stay on:
# CA_BUNDLE=/path/to/corporate-ca.pem

# --- Agents (used in agents/<name>/agent.yaml) ---
KNOWLEDGE_ADK_BASE_URL=http://localhost:8080
KNOWLEDGE_ADK_APP_NAME=knowledge_agent

# --- Synthesizer source athena_mcp: Hive Athena MCP server (make sources / make goldens) ---
HIVE_ATHENA_BASE_URL=https://web203-int-ew2.c2.test.lbgcp.cloud/cct1/hive1/athena-mcp-server
HIVE_ATHENA_CLIENT_ID=
HIVE_ATHENA_CLIENT_SECRET=

# --- Judge model via CORTEX (DeepEval judges and the synthesizer) ---
# How to reach CORTEX:
#   api_key  call CORTEX_HOST directly with CORTEX_CLIENT_ID + CORTEX_API_KEY (below)
#   devkit   CorteX DevKit: no API key — run `make cortex-login` once (SSO in the browser)
CORTEX_AUTH=api_key
CORTEX_MODEL=vertex_ai/gemini-2.5-pro

# api_key mode (and Pegasus, which signs its own calls):
# Gateway URL ending in /v1 — the client appends /chat/completions
CORTEX_HOST=https://<cortex-host>/.../v1
# Sent as x-lbg-origin-client-id
CORTEX_CLIENT_ID=
# CorteX 2.0: sent as Authorization: Bearer <key> (DeepEval + Pegasus)
CORTEX_API_KEY=

# devkit mode (optional): pin an environment instead of auto-discovery — int, pre or prd
# CORTEX_ENV=prd
# devkit mode (optional): chat endpoint, relative to the DevKit's base address — only if the automatic
# choice (/v1/chat/completions on the LBG hosts) is wrong
# CORTEX_DEVKIT_CHAT_PATH=/v1/chat/completions
CORTEX_TIMEOUT_S=60
# Retries on 429 / 5xx / network errors
CORTEX_RETRIES=2

# --- Pegasus (only if the Pegasus package is installed) ---
# Uses CORTEX_API_KEY above (CorteX 2.0), or CORTEX_CLIENT_ID + CORTEX_CLIENT_SECRET — also in devkit
# mode. Without them, Pegasus metrics run on DeepEval (a warning says so).
# Optional; defaults to CORTEX_HOST
CORTEX_BASE_URL=
CORTEX_CLIENT_SECRET=
PEGASUS_CORTEX_MODEL=gemini-2.5-flash
# PEGASUS_CERT_PATH=
