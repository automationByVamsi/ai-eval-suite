"""
Custom client for agents that are NOT Google ADK: rename to client.py to replace the built-in ADK client.
`settings` is agent.yaml's `connection:` section, with env/.env values filled in.
Return a trace dict: only "agentOutput" is required; keep "raw_response" for parser.py and --offline replays.
"""

import time

import httpx


def call_agent(settings, message):
    """Send one message to the agent and return its trace dict."""
    start = time.perf_counter()
    response = httpx.post(
        f"{settings['base_url']}/chat",                 # TODO: your agent's endpoint
        json={"message": message},                      # TODO: your agent's request body
        headers=settings.get("headers") or {},
        timeout=float(settings.get("timeout_s", 120)),
    )
    response.raise_for_status()
    body = response.json()
    return {
        "agentOutput": body["answer"],                  # TODO: where the final answer is
        "context": body.get("sources", []),             # optional: retrieved context, for faithfulness
        "latency_ms": round((time.perf_counter() - start) * 1000, 1),
        "raw_response": body,
    }
