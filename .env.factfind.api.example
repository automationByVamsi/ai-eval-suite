# Copy to .env.factfind.api and fill in real values. Do NOT commit secrets.
#
# Used by: python -m scripts.generate_factfind_payloads

COUNTER_API_VERSION=v3

# Counter API v3 (Account Details + Customer Holdings)
COUNTER_V3_IBM_CLIENT_ID=
COUNTER_V3_IBM_CLIENT_SECRET=
COUNTER_V3_CONSENT_LEVEL=2
COUNTER_V3_OUTLET_ID=
COUNTER_V3_USER_ID=

# Counter API v1 (only if COUNTER_API_VERSION=v1)
COUNTER_V1_IBM_CLIENT_ID=
COUNTER_V1_IBM_CLIENT_SECRET=
COUNTER_V1_CONSENT_LEVEL=2
COUNTER_V1_OUTLET_ID=
COUNTER_V1_USER_ID=

# OCIS (Contact Notes + Trusted Parties)
OCIS_IBM_CLIENT_ID=
OCIS_IBM_CLIENT_SECRET=
OCIS_USER_ID=
OCIS_USER_ID_TYPE=60
OCIS_OUTLET_ID=
OCIS_OUTLET_ID_TYPE=OU_ID
OCIS_APPLICATION_ID=
OCIS_CONSENT_LEVEL=2

# Nucleus / ICA
NUCLEUS_IMPERSONATE_USER_ID=ICAINDAPI

# Optional mTLS for APIC (place certs under data/fact_find_workflow/certs/)
FACTFIND_APIC_CERT_PATH=data/fact_find_workflow/certs/apic.pem
FACTFIND_APIC_KEY_PATH=data/fact_find_workflow/certs/apic.key

FACTFIND_HTTP_TIMEOUT_S=60
FACTFIND_HTTP_RETRIES=1

COMPLAINT_REFS_FILE=data/fact_find_workflow/complaint-references.json
